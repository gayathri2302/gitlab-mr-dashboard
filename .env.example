# ── Backend API URL ───────────────────────────────────────────────────────────
# In dev this is not needed — Vite proxies /api and /auth to localhost:3001
# In production set this to your deployed gitlabservice URL (no trailing slash)
VITE_API_URL=https://your-gitlabservice-url.com

# ── GitLab Tokens ─────────────────────────────────────────────────────────────
# Default token used for all users not listed below
GITLAB_TOKEN=your_default_gitlab_token

# Per-user tokens — used when the named user is logged in
# If not set, falls back to GITLAB_TOKEN
GITLAB_TA_TOKEN=thendral_gitlab_personal_access_token
GITLAB_PP_TOKEN=priyanka_gitlab_personal_access_token
